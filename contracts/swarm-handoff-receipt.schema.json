{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Swarm Handoff Receipt","type":"object","additionalProperties":false,"required":["schema_version","receipt_id","workstream_envelope_sha256","from_agent","to_agent","context_sha256","evidence_refs","unresolved_risks","next_safe_action","client_authority_owner","execution_authorized","effect_summary"],"properties":{"schema_version":{"const":"1.0.0"},"receipt_id":{"type":"string","pattern":"^SHR-[A-Z0-9-]+$"},"workstream_envelope_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"from_agent":{"type":"string","minLength":1},"to_agent":{"type":"string","minLength":1},"context_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"unresolved_risks":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"next_safe_action":{"enum":["request_client_authorization","collect_evidence","stop"]},"client_authority_owner":{"const":"client"},"execution_authorized":{"const":false},"effect_summary":{"type":"array","maxItems":0}}}
