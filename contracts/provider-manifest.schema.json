{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Provider Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "kind", "version", "status", "source_identity", "required_permissions", "network_behavior", "hook_behavior", "persistence_behavior", "execution_behavior", "evidence_requirements", "limitations", "human_disposition", "next_stage_authorized"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "provider_id": {"type": "string", "pattern": "^PROVIDER-[A-Z0-9-]+$"},
    "kind": {"enum": ["graph_provider", "planning_provider", "catalog_provider", "worker_orchestration_provider", "workflow_pack_provider"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "declared_disabled"},
    "source_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["intake_status", "repository_locator", "commit", "tree", "parent", "source_blobs"],
      "properties": {
        "intake_status": {"const": "public_read_only"},
        "repository_locator": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "parent": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_blobs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha1"], "properties": {"path": {"type": "string", "minLength": 1}, "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}}
      }
    },
    "required_permissions": {"type": "array", "uniqueItems": true, "items": {"enum": ["git_object_read", "artifact_read"]}},
    "network_behavior": {"const": "forbidden"}, "hook_behavior": {"const": "forbidden"}, "persistence_behavior": {"const": "forbidden"}, "execution_behavior": {"const": "forbidden"},
    "evidence_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "human_disposition": {"const": "pending"}, "next_stage_authorized": {"const": false}
  }
}
