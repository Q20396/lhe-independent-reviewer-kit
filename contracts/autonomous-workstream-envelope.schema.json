{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomous Workstream Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workstream_id",
    "spec_sha256",
    "target_identity_manifest_sha256",
    "client_authority_owner",
    "authorization_state",
    "execution_authorized",
    "agents",
    "effect_budget",
    "allowed_paths",
    "stop_conditions",
    "evidence_outputs"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "workstream_id": {"type": "string", "pattern": "^AWS-[A-Z0-9-]+$"},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_identity_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "client_authority_owner": {"const": "client"},
    "authorization_state": {"const": "pending"},
    "execution_authorized": {"const": false},
    "agents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "effect_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_handoffs", "max_tool_calls", "max_tokens", "allowed_effects"],
      "properties": {
        "max_handoffs": {"type": "integer", "minimum": 0, "maximum": 12},
        "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 30},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 200000},
        "allowed_effects": {"type": "array", "maxItems": 0}
      }
    },
    "allowed_paths": {"type": "array", "maxItems": 0},
    "stop_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["handoff_receipt", "evidence_bundle", "limitation_report"]}}
  }
}
