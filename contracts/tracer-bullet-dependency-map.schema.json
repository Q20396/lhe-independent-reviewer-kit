{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:independent-reviewer-kit:tracer-bullet-dependency-map:1.0.0",
  "title": "Static Tracer-Bullet Dependency Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "map_id", "workstream_capsule_id", "spec_sha256", "items", "allowed_effects", "human_disposition", "next_stage_authorized"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "map_id": {"type": "string", "pattern": "^TBDM-[A-Z0-9-]+$"},
    "workstream_capsule_id": {"type": "string", "pattern": "^WSC-[A-Z0-9-]+$"},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/item"}},
    "allowed_effects": {"const": []},
    "human_disposition": {"const": "pending"},
    "next_stage_authorized": {"const": false}
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "title", "deliverable", "acceptance_criteria", "blocked_by", "status", "evidence_refs", "allowed_effects", "execution_authorized"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^TBI-[A-Z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "deliverable": {"type": "string", "minLength": 1},
        "acceptance_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "blocked_by": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TBI-[A-Z0-9-]+$"}},
        "status": {"const": "proposed"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVID-[A-Z0-9-]+$"}},
        "allowed_effects": {"const": []},
        "execution_authorized": {"const": false}
      }
    }
  }
}
