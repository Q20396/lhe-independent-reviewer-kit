{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q20396.github.io/lhe-independent-reviewer-kit/schemas/review-advisor-response.schema.json",
  "title": "Independent Review Advisor Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "profile_id", "selected_modules", "required_permissions", "missing_evidence", "limitations", "next_safe_action", "human_disposition", "next_stage_authorized"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"enum": ["eligible", "blocked", "unverified", "requires_human_decision"]},
    "profile_id": {"type": "string", "minLength": 1},
    "selected_modules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "required_permissions": {"type": "array", "uniqueItems": true, "items": {"enum": ["git_object_read", "artifact_read"]}},
    "missing_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "next_safe_action": {"type": "string", "minLength": 1},
    "human_disposition": {"const": "pending"},
    "next_stage_authorized": {"const": false}
  }
}
