{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Non-sensitive Workstream Capsule","type":"object","additionalProperties":false,"required":["schema_version","capsule_id","workflow_pack_sha256","spec_sha256","phase","evidence_refs","blockers","next_safe_action","persistence_requested","client_authority_owner","human_disposition","next_stage_authorized"],"properties":{"schema_version":{"const":"1.0.0"},"capsule_id":{"type":"string","pattern":"^WSC-[A-Z0-9-]+$"},"workflow_pack_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"spec_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"phase":{"enum":["planned","blocked","evidence_collected","requires_human_decision"]},"evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^EVID-[A-Z0-9-]+$"}},"blockers":{"type":"array","uniqueItems":true,"items":{"enum":["MISSING_EVIDENCE","TARGET_IDENTITY_UNVERIFIED","CLIENT_DECISION_REQUIRED","BUDGET_EXHAUSTED"]}},"next_safe_action":{"enum":["collect_evidence","request_client_decision","stop"]},"persistence_requested":{"const":false},"client_authority_owner":{"const":"client"},"human_disposition":{"const":"pending"},"next_stage_authorized":{"const":false}}}
