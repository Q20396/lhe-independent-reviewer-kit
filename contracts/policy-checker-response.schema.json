{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q20396.github.io/lhe-independent-reviewer-kit/schemas/policy-checker-response.schema.json",
  "title": "LHE Policy Snapshot Checker Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "snapshot_commit", "snapshot_tree", "status", "requested_permissions", "requested_behaviors", "missing_evidence", "limitations", "next_safe_action", "human_disposition", "next_stage_authorized"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"type": "string", "pattern": "^LHE-SNAPSHOT-[A-Z0-9-]+$"},
    "snapshot_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "snapshot_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["eligible", "blocked", "unverified", "requires_human_decision"]},
    "requested_permissions": {"type": "array", "uniqueItems": true, "items": {"enum": ["git_object_read", "artifact_read"]}},
    "requested_behaviors": {"type": "object", "additionalProperties": false, "required": ["network_behavior", "hook_behavior", "persistence_behavior", "promotion_authority"], "properties": {"network_behavior": {"const": "forbidden"}, "hook_behavior": {"const": "forbidden"}, "persistence_behavior": {"const": "forbidden"}, "promotion_authority": {"const": "none"}}},
    "missing_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "next_safe_action": {"type": "string", "minLength": 1},
    "human_disposition": {"const": "pending"},
    "next_stage_authorized": {"const": false}
  }
}
