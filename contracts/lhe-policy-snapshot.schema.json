{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q20396.github.io/lhe-independent-reviewer-kit/schemas/lhe-policy-snapshot.schema.json",
  "title": "Supplied LHE Policy Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "source_repository_locator", "commit", "tree", "selected_paths", "path_inventory_sha256", "retrieved_at", "known_limitations", "policy_claims", "human_disposition", "next_stage_authorized"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"type": "string", "pattern": "^LHE-SNAPSHOT-[A-Z0-9-]+$"},
    "source_repository_locator": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "selected_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path_entry"}},
    "path_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of canonical sorted selected_paths declarations; does not prove source blobs."},
    "retrieved_at": {"type": "string", "minLength": 1},
    "known_limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "policy_claims": {"$ref": "#/$defs/policy_claims"},
    "human_disposition": {"const": "pending"},
    "next_stage_authorized": {"const": false}
  },
  "$defs": {
    "path_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blob_oid", "content_sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\x00\\r\\n]+$"},
        "blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$", "description": "Opaque, declared source blob identity; not rehashed by this static checker."},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Opaque, declared content digest; not rehashed by this static checker."}
      }
    },
    "policy_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_permissions", "network_behavior", "hook_behavior", "persistence_behavior", "promotion_authority"],
      "properties": {
        "allowed_permissions": {"type": "array", "uniqueItems": true, "items": {"enum": ["git_object_read", "artifact_read"]}},
        "network_behavior": {"const": "forbidden"},
        "hook_behavior": {"const": "forbidden"},
        "persistence_behavior": {"const": "forbidden"},
        "promotion_authority": {"const": "none"}
      }
    }
  }
}
