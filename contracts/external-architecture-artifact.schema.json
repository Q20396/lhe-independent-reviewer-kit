{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q20396.github.io/lhe-independent-reviewer-kit/schemas/external-architecture-artifact.schema.json",
  "title": "Supplied External Architecture Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "source_repository", "ref", "commit", "license", "retrieved_at", "acquisition_method", "evidence_state", "evidence_items", "known_limitations", "human_disposition", "next_stage_authorized"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"type": "string", "pattern": "^EXT-ART-[A-Z0-9-]+$"},
    "source_repository": {"type": "string", "minLength": 1},
    "ref": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "license": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "minLength": 1},
    "acquisition_method": {"const": "public_read_only"},
    "evidence_state": {"const": "declared_opaque", "description": "Supplied metadata, not independently verified raw bytes."},
    "evidence_items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_item"}},
    "known_limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "human_disposition": {"const": "pending"},
    "next_stage_authorized": {"const": false}
  },
  "$defs": {
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "path", "content_sha256", "provenance"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^EXT-EV-[A-Z0-9-]+$"},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\x00\\r\\n]+$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provenance": {"enum": ["EXTRACTED", "INFERRED"]}
      }
    }
  }
}
